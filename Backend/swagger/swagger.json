    "/api/donations/create-paypal-payment": {
      "post": {
        "summary": "Create a PayPal payment",
        "tags": ["Donation_API"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number"
                  }
                },
                "required": ["amount"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PayPal payment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "href": {
                            "type": "string"
                          },
                          "rel": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error creating PayPal payment"
          }
        }
      }
    },
    "/api/donations/execute-paypal-payment": {
      "post": {
        "summary": "Execute a PayPal payment",
        "tags": ["Donation_API"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
