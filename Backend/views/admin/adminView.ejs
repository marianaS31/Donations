<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Ver Informação</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/sidebar.css"/>
    <script src="/javascript/sidebar.js"></script>
    
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/admins">Adminstradores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/donors">Doadores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/entities">Entidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/doacao">Registo Doações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/">Inicio</a>
                        </li>
                        <% if (!user) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="http://localhost:8000/login">Login</a>
                            </li>
                        <% } %>
                    </ul>
                    <% if (user) { %>
                        <div class="mt-3">
                            <form action="/logout" method="get">
                                <button type="submit" class="btn btn-link logout-link">Logout</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </nav>
</head>
<body>
    <div class="container mt-5">
        <h1>Ver Informação</h1>
        <form action="/admins/<%= admin._id %>/view" method="GET">
            <div class="form-group">
                <label><b>Nome:</b> <br> <%= admin.name %> </label>
                
            </div>
            <div class="form-group">
                <label><b>Email:</b> <br> <%= admin.email %> </label>

            </div>
  
            <div class="form-group">
                <label for="tipo"><b>Role:</b> <br> <%= admin.tipo %> </label>

            </div>
            </form>
            <div>
                <form action="/admins/<%= admin._id %>/edit" method="GET" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-info ml-2">Editar</button>
                </form>
                <form action="/admins/<%= admin._id %>/delete" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-danger ml-2">Eliminar</button>
                </form>

            </div>
            

        </form>
    </div>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>