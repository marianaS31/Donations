<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de Doações</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/sidebar.css"/>
    <script src="/javascript/sidebar.js"></script>
    
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/admins">Adminstradores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/donors">Doadores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/entities">Entidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/doacao">Registo Doações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/">Inicio</a>
                        </li>
                        <% if (!user) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="http://localhost:8000/login">Login</a>
                            </li>
                        <% } %>
                    </ul>
                    <% if (user) { %>
                        <div class="mt-3">
                            <form action="/logout" method="get">
                                <button type="submit" class="btn btn-link logout-link">Logout</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </nav>
    <div class="container mt-5 text-center">
        <h1>Gestão de Doações</h1>
        
        <form action="/doacao/search" method="POST" class="mb-4">
            <div class="input-group">
                <input type="text" class="form-control" name="searchTerm" placeholder="Procurar por e-mail...">
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit">Procurar</button>
                </div>
            </div>
        </form>

        <ul class="list-group">
            <% if (searchResults && Array.isArray(searchResults) && searchResults.length > 0) { %>
                <% searchResults.forEach(donor => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><%= donor.name %> - <%= donor.points %> pontos - <%= donor.email %></span>
                    </li>
                <% }); %>
            <% } else { %>
                <li class="list-group-item">Nenhum resultado encontrado.</li>
            <% } %>
        </ul>

        <div class="mt-4">
            <a href="/doacao/create" class="btn btn-success">Criar Doação</a>
            <a href="/doacao/list" class="btn btn-info">Listar Doações</a>
        </div>
    </div>

    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
