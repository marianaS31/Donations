<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Criar Nova Doação</title>
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/stylesheets/sidebar.css" />
    <script src="/javascript/donationsAdd.js"></script>
    <script src="/javascript/sidebar.js"></script>
    <style></style>
  </head>
  <body>
    <div class="container-fluid">
      <div class="row">
        <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
          <div class="sidebar-sticky">
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/admins"
                  >Adminstradores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/donors"
                  >Doadores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/entities"
                  >Entidades</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/doacao"
                  >Registo Doações</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/">Inicio</a>
              </li>
              <% if (!user) { %>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/login">Login</a>
              </li>
              <% } %>
            </ul>
            <% if (user) { %>
            <div class="mt-3">
              <form action="/logout" method="get">
                <button type="submit" class="btn btn-link logout-link">
                  Logout
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </nav>
        <div class="col-md-10">
          <div class="container mt-5">
            <h1>Criar Nova Doação</h1>
            <form id="donationForm" action="/doacao/create" method="POST">
              <div class="form-group">
                <label for="donorEmail">Email do Doador:</label>
                <input
                  type="email"
                  class="form-control"
                  name="donorEmail"
                  required
                />
              </div>
              <div class="form-group">
                <label for="entity">Entidade:</label>
                <input
                  type="text"
                  class="form-control"
                  name="entity"
                  required
                />
              </div>

              <div id="donationFields"></div>
              <button
                type="button"
                class="btn btn-primary"
                onclick="addDonation()"
              >
                Adicionar Doação
              </button>
              <button
                type="button"
                class="btn btn-success"
                onclick="submitForm()"
              >
                Finalizar Doações
              </button>
              <div id="error-section">
                <% if (erros && erros.length > 0) { %>
                <ul class="list-unstyled">
                  <% for (let i = 0; i < erros.length; i++) { %>
                  <li><%= erros[i] %></li>
                  <% } %>
                </ul>
                <% } %>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <script>
      function toggleStateField() {
        const donationType = document.getElementById("donationType").value;
        const stateField = document.getElementById("stateField");
        if (donationType === "Cloth") {
          stateField.style.display = "block";
        } else {
          stateField.style.display = "none";
        }
      }
    </script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </body>
</html>
