<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Lista de Doações</title>
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/stylesheets/sidebar.css" />
  <script src="/javascript/donationsAdd.js"></script>
  <script src="/javascript/sidebar.js"></script>
  <style></style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
        <div class="sidebar-sticky">
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="http://localhost:8000/admins">Adminstradores</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="http://localhost:8000/donors">Doadores</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="http://localhost:8000/entities">Entidades</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="http://localhost:8000/doacao">Registo Doações</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="http://localhost:8000/">Inicio</a>
            </li>
            <% if (!user) { %>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/login">Login</a>
              </li>
            <% } %>
          </ul>
          <% if (user) { %>
            <div class="mt-3">
              <form action="/logout" method="get">
                <button type="submit" class="btn btn-link logout-link">Logout</button>
              </form>
            </div>
          <% } %>
        </div>
      </nav>
      <main role="main" class="col-md-9 ml-sm-auto col-lg-10 px-4">
        <h1 class="mt-4">Lista de Doações</h1>
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>#</th>
              <th>Email do Doador</th>
              <th>Entidade</th>
              <th>Detalhes</th>
              <th>Data</th>
              <th>Ações</th> 
            </tr>
          </thead>
          <tbody>
            <% doacoes.forEach((doacao, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= doacao.donorEmail %></td>
                <td><%= doacao.entity %></td>
                <td>
                  <% doacao.donations.forEach((donation, i) => { %>
                    <% if (donation.type === 'money') { %>
                      <div>Doação <%= i + 1 %>: Quantidade - <%= donation.quantity %></div>
                    <% } else if (donation.type === 'cloth') { %>
                      <div>Doação <%= i + 1 %>: Peso - <%= donation.kg %> kg, Cor - <%= donation.color %>, Tipo - <%= donation.clothType %></div>
                    <% } %>
                    <!-- State editing form -->
                    <form action="/doacao/updateState/<%= doacao._id %>/<%= i %>" method="post" style="display:inline;">
                      <select name="state" class="custom-select custom-select-sm" onchange="this.form.submit()">
                        <option value="Entregue" <%= donation.state === 'Entregue' ? 'selected' : '' %>>Entregue</option>
                        <option value="Recebido" <%= donation.state === 'Recebido' ? 'selected' : '' %>>Recebido</option>
                        <option value="Extraviado" <%= donation.state === 'Extraviado' ? 'selected' : '' %>>Extraviado</option>
                        <option value="Analise" <%= donation.state === 'Analise' ? 'selected' : '' %>>Analise</option>
                        <option value="Em deslocação" <%= donation.state === 'Em deslocação' ? 'selected' : '' %>>Em deslocação</option>
                      </select>
                    </form>
                  <% }); %>
                </td>
                <td><%= new Date(doacao._id.getTimestamp()).toLocaleDateString() %></td>
                <td>
                  <form action="/doacao/delete/<%= doacao._id %>" method="post">
                    <input type="hidden" name="_method" value="delete">
                    <button type="submit" class="btn btn-danger btn-sm">Apagar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </main>
    </div>
  </div>
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
