<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/sidebar.css" />
    <script src="/javascript/sidebar.js"></script>
  </head>
  <body>
    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
          <div class="sidebar-sticky">
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/admins"
                  >Adminstradores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/donors"
                  >Doadores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/entities"
                  >Entidades</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/doacao"
                  >Registo Doações</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/">Inicio</a>
              </li>
              <% if (!user) { %>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/login">Login</a>
              </li>
              <% } %>
            </ul>
            <% if (user) { %>
            <div class="mt-3">
              <form action="/logout" method="get">
                <button type="submit" class="btn btn-link logout-link">
                  Logout
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </nav>

        <form method="post" action="/donors/add" class="container">
          <div class="container">
            <h1 class="text-center">Registar um Doador</h1>
            <p class="text-center">Preencha o formulário para criar a conta.</p>
            <hr />

            <div class="form-group">
              <label for="name"><b>Nome</b></label>
              <input
                type="text"
                class="form-control"
                placeholder="Introduzir Nome"
                name="name"
                id="name"
                required
              />
            </div>

            <div class="form-group">
              <label for="lname"><b>Sobrenome</b></label>
              <input
                type="text"
                class="form-control"
                placeholder="Introduzir Sobrenome"
                name="lname"
                id="lname"
                required
              />
            </div>

            <div class="form-group">
              <label for="age"><b>Idade</b></label>
              <input
                type="number"
                class="form-control"
                placeholder="Introduzir idade"
                name="age"
                id="age"
                required
              />
            </div>

            <div class="form-group">
              <label for="email"><b>Email</b></label>
              <input
                type="text"
                class="form-control"
                placeholder="Introduzir Email"
                name="email"
                id="email"
                required
              />
            </div>

            <div class="form-group">
              <label for="psw"><b>Password</b></label>
              <input
                type="password"
                class="form-control"
                placeholder="Introduzir Password"
                name="psw"
                id="psw"
                required
              />
            </div>

            <div class="form-group">
              <label for="pswrepeat"><b>Repetir Password</b></label>
              <input
                type="password"
                class="form-control"
                placeholder="Repetir Password"
                name="pswrepeat"
                id="pswrepeat"
                required
              />
            </div>

            <hr />
            <button type="submit" class="btn btn-success btn-block">
              Adicionar
            </button>
          </div>
          <div id="error-section" class="container mt-3">
            <% if (erros && erros.length > 0) { %>
            <div class="alert alert-danger">
              <ul class="list-unstyled">
                <% erros.forEach(function(erro) { %>
                <li><%= erro %></li>
                <% }); %>
              </ul>
            </div>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
