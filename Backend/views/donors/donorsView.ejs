<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <title>Informação Doador</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/sidebar.css" />
    <!-- Assuming this is your custom CSS for the sidebar -->
    <script src="/javascript/sidebar.js"></script>
  </head>
  <body>
    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
          <div class="sidebar-sticky">
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/admins"
                  >Adminstradores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/donors"
                  >Doadores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/entities"
                  >Entidades</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/doacao"
                  >Registo Doações</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/">Inicio</a>
              </li>
              <% if (!user) { %>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/login">Login</a>
              </li>
              <% } %>
            </ul>
            <% if (user) { %>
            <div class="mt-3">
              <form action="/logout" method="get">
                <button type="submit" class="btn btn-link logout-link">
                  Logout
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </nav>
        <!-- Main content -->
        <div class="col-md-10">
          <div class="container mt-5">
            <h1>Informação Doador</h1>
            <form action="/donors/<%= donor._id %>/view" method="GET">
              <div class="form-group">
                <label><b>Nome:</b> <br /><%= donor.name %></label>
              </div>
              <div class="form-group">
                <label><b>Email:</b> <br /><%= donor.email %></label>
              </div>
              <div class="form-group">
                <label><b>Pontos:</b> <br /><%= donor.points %></label>
              </div>
            </form>
              <div>
                <!-- Formulário para editar o doador -->
                <form
                  action="/donors/<%= donor._id %>/edit"
                  method="GET"
                  style="display: inline"
                >
                  <button type="submit" class="btn btn-primary btn-sm">
                    Editar
                  </button>
                </form>
                <!-- Formulário para excluir o doador -->
                <form
                  action="/donors/<%= donor._id %>/delete"
                  method="POST"
                  style="display: inline"
                >
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-danger btn-sm">
                    Eliminar
                  </button>
                </form>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </body>
</html>
