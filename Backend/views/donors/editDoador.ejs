<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <title>Editar Doador</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/sidebar.css" />
    <!-- Assuming this is your custom CSS for the sidebar -->
    <script src="/javascript/sidebar.js"></script>
  </head>
  <body>
    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
          <div class="sidebar-sticky">
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/admins"
                  >Adminstradores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/donors"
                  >Doadores</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/entities"
                  >Entidades</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/doacao"
                  >Registo Doações</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/">Inicio</a>
              </li>
              <% if (!user) { %>
              <li class="nav-item">
                <a class="nav-link" href="http://localhost:8000/login">Login</a>
              </li>
              <% } %>
            </ul>
            <% if (user) { %>
            <div class="mt-3">
              <form action="/logout" method="get">
                <button type="submit" class="btn btn-link logout-link">
                  Logout
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </nav>
        <!-- Main content -->
        <div class="col-md-10">
          <div class="container mt-5">
            <h1>Editar Doador</h1>
            <form action="/donors/<%= doador._id %>/edit" method="POST">
              <div class="form-group">
                <label>Nome:</label>
                <input
                  type="text"
                  name="name"
                  class="form-control"
                  value="<%= doador.name %>"
                  required
                />
              </div>
              <div class="form-group">
                <label>Email:</label>
                <input
                  type="email"
                  name="email"
                  class="form-control"
                  value="<%= doador.email %>"
                  required
                />
              </div>
              <div class="form-group">
                <label>Pontos:</label>
                <input
                  type="number"
                  name="points"
                  class="form-control"
                  value="<%= doador.points %>"
                />
              </div>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </body>
</html>
