<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entities</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/sidebar.css"/>
    <script src="/javascript/sidebar.js"></script>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/admins">Adminstradores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/donors">Doadores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/entities">Entidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/doacao">Registo Doações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/">Inicio</a>
                        </li>
                        <% if (!user) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="http://localhost:8000/login">Login</a>
                            </li>
                        <% } %>
                    </ul>
                    <% if (user) { %>
                        <div class="mt-3">
                            <form action="/logout" method="get">
                                <button type="submit" class="btn btn-link logout-link">Logout</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </nav>
    <div class="container mt-5 text-center">
                <h1>Gestão de Entidades</h1>
        <form action="/entities/search" method="POST" class="mb-3">
            <div class="input-group">
                <input type="string" class="form-control" name="searchTerm" placeholder="Procurar por nome...">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary">Procurar</button>
                </div>
            </div>
    
        </form>

        <ul class="list-group">
            <% if (searchResults && Array.isArray(searchResults) && searchResults.length > 0) { %>
                <% searchResults.forEach(entitie => { %>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <a class="nav-link" href="http://localhost:8000/entities/<%= entitie._id %>/view"> <%= entitie.name %> </a>
                            <div class="btn-group" role="group">
                                <form action="/entities/<%= entitie._id %>/edit" method="GET">
                                    <button type="submit" class="btn btn-info mr-2">Editar</button>
                                </form>
                                <form action="/entities/<%= entitie._id %>/delete" method="POST">
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                </form>
                            </div>
                        </div>
                    </li>
                <% }); %>
            <% } else { %>
                <li class="list-group-item">Nenhum resultado encontrado.</li>
            <% } %>
        </ul>
        <div class="mt-3">
            <a href="http://localhost:8000/entities/add" class="btn btn-success">Adicionar</a>
        </div>
        
    </div>
    
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
