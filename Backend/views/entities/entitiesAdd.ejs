<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<link rel="stylesheet" href="/stylesheets/sidebar.css"/>
<script src="/javascript/sidebar.js"></script>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
        <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
            <div class="sidebar-sticky">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="http://localhost:8000/admins">Adminstradores</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="http://localhost:8000/donors">Doadores</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="http://localhost:8000/entities">Entidades</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="http://localhost:8000/doacao">Registo Doações</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="http://localhost:8000/">Inicio</a>
                    </li>
                    <% if (!user) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/login">Login</a>
                        </li>
                    <% } %>
                </ul>
                <% if (user) { %>
                    <div class="mt-3">
                        <form action="/logout" method="get">
                            <button type="submit" class="btn btn-link logout-link">Logout</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </nav>

<form method="post" action="/entities/add" class="container">
  <div class="container">
    <h1>Adicionar uma entidade</h1>
    <p>Preencha o formulário para criar uma entidade.</p>
    <hr>

    <label for="name"><b>Nome</b></label>
    <input type="text" class="form-control" placeholder="Introduza Nome" name="name" id="name" required>

    <label for="description"><b>Descrição</b></label>
    <input type="text" class="form-control" placeholder="Introduza Descrição" name="description" id="description" required>

    <label for="distrito">Destrito</label>
    <input type="text" class="form-control" placeholder="Introduza o distrito" name="distrito" id="distrito" required>

    <div class="form-group">
        <label for="email"><b>Email</b></label>
        <input type="text" class="form-control" placeholder="Introduzir Email" name="email" id="email" required>
      </div>

    <div class="form-group">
        <label for="psw"><b>Password</b></label>
        <input type="password" class="form-control" placeholder="Introduzir Password" name="psw" id="psw" required>
    </div>
  
    <div class="form-group">
        <label for="pswrepeat"><b>Repetir Password</b></label>
        <input type="password" class="form-control" placeholder="Repetir Password" name="pswrepeat" id="pswrepeat" required>
    </div>
    <label for="image">Seleciona image:</label>
    <input type="file" class="form-control-file" id="image" name="image" accept="image/*">
  
    <button type="submit" class="btn btn-primary mt-3" >Add</button>
  </div>
  <div id="error-section">
    <% if (erros && erros.length > 0) { %>
        <ul>
            <% for (let i = 0; i < erros.length; i++) { %>
                <li><%= erros[i] %></li>
            <% } %>
        </ul>
    <% } %>
  </div>
</form>






</body>
</html>
