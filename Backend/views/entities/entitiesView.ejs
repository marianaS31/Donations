<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Entidade</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/sidebar.css"/>
    <script src="/javascript/sidebar.js"></script>
    
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block bg-light sidebar" id="sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/admins">Adminstradores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/donors">Doadores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/entities">Entidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/doacao">Registo Doações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="http://localhost:8000/">Inicio</a>
                        </li>
                        <% if (!user) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="http://localhost:8000/login">Login</a>
                            </li>
                        <% } %>
                    </ul>
                    <% if (user) { %>
                        <div class="mt-3">
                            <form action="/logout" method="get">
                                <button type="submit" class="btn btn-link logout-link">Logout</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </nav>
</head>
<body>
    <div class="container mt-5">
        <h1>Editar Entidade</h1>
        <form action="/entities/<%= entitie._id %>/view" method="POST">
            <div class="form-group">
                <label><b>Nome:</b> <br> <%= entitie.name %> </label>
            </div>
            <div class="form-group">
                <label> <b>Descrição:</b> <br> <%= entitie.description %> </label>
            </div>
            <div class="form-group">
                <p><b>Imagem:</b></p>
                <% const defaultImage = '/default.png'; %>
                <img src="/image/<%= entitie.image || defaultImage %>" alt="Entidade" class="img-thumbnail">
            </div>
            </form>

            <div class="btn-group" role="group">
                <form action="/entities/<%= entitie._id %>/edit" method="GET">
                    <button type="submit" class="btn btn-info mr-2">Editar</button>
                </form>
                <form action="/entities/<%= entitie._id %>/delete" method="POST">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>

        </form>
    </div>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>