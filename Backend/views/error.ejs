<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container bg-white rounded shadow p-4" style="margin-top: 50px; width: 300px;">
        <h2 class="text-danger">Error</h2>
        <p><%= message %></p>
        <% if (error.stack) { %>
            <pre><%= error.stack %></pre>
        <% } %>
    </div>
</body>
</html>
